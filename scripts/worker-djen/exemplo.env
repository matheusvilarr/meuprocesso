# Copie este arquivo para ".env" (nesta mesma pasta) e preencha.
# O .env fica fora do git. Quem tem os valores: o Matheus (painel da Vercel/Supabase).

# OBRIGATÓRIA — chave de serviço do Supabase (a mesma do worker da fila STJ).
SUPABASE_SERVICE_KEY=

# Recomendada — segredo dos workers (o mesmo STJ_FILA_SECRET da fila STJ).
# Com ela, intimação nova dispara o e-mail na hora; sem ela, vai no resumo da manhã/tarde.
STJ_FILA_SECRET=

# Recomendada — chave da Resend. Com ela, "processo novo encontrado na sua OAB" vai por e-mail;
# sem ela, a sugestão aparece só no painel.
RESEND_API_KEY=
