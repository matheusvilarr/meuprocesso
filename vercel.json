{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "code", "value": "(?<code>.*)" }],
      "destination": "/redefinir-senha?code=:code",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/buscar-processo.js":             { "maxDuration": 20 },
    "api/cron/sincronizar.js":            { "maxDuration": 120 },
    "api/cron/verificar-atualizacoes.js": { "maxDuration": 30 },
    "api/admin.js":                        { "maxDuration": 90 }
  },
  "crons": [
    { "path": "/api/cron/sincronizar",                           "schedule": "0 8 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 10 * * 1-5" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=morning",   "schedule": "30 10 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 12 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 14 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 16 * * 1-5" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=afternoon", "schedule": "30 16 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 18 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 20 * * 1-5" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=evening",   "schedule": "0 21 * * 1-5" },
    { "path": "/api/cron/sincronizar?tipo=oab",                  "schedule": "30 21 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 22 * * 1-5" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 10 * * 0,6" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=morning",   "schedule": "30 10 * * 0,6" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 14 * * 0,6" },
    { "path": "/api/cron/sincronizar",                           "schedule": "0 18 * * 0,6" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=afternoon", "schedule": "30 18 * * 0,6" },
    { "path": "/api/cron/sincronizar?tipo=oab",                  "schedule": "0 21 * * 0,6" },
    { "path": "/api/cron/verificar-atualizacoes?tipo=prazo_fatal", "schedule": "0 12 * * *" }
  ]
}
